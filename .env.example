# 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 数据库配置
DATABASE_URL=mysql+pymysql://agri_user:agri_pass@mysql:3306/agri_platform

# Redis配置
REDIS_URL=redis://redis:6379/0

# 加密密钥（生产环境必须修改）
ENCRYPTION_KEY=your-secret-encryption-key-here

# 环境
ENVIRONMENT=production

# CORS配置
CORS_ORIGINS=http://localhost,http://localhost:80

# JWT密钥
SECRET_KEY=your-secret-jwt-key-here

# 上传目录
UPLOAD_DIR=uploads

# 日志级别
LOG_LEVEL=INFO
