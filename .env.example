# ============================
# 环境变量配置示例
# ============================
# 使用方法:
#   复制此文件为 .env 并修改相应的值
#   cp .env.example .env
#
# Docker 部署请参考 .env.docker.example

# ---- 数据库 ----
DATABASE_URL=mysql+pymysql://agri_user:agri_pass@localhost:3306/agri_platform?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 应用配置 ----
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-please-change-in-production-env-32chars
ENCRYPTION_KEY=default-key-change-in-production
UPLOAD_DIR=uploads
LOG_LEVEL=INFO

# ---- CORS ----
# 开发环境
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
# 生产环境（取消注释并替换）
# CORS_ORIGINS=https://shushang.online,https://www.shushang.online

# ---- DeepSeek AI API ----
# 获取密钥: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 京东联盟开放平台 ----
# 申请地址: https://union.jd.com
JD_APP_KEY=
JD_SECRET_KEY=
# JD_OAUTH_REDIRECT_URI=https://shushang.online/api/v1/jd/oauth/callback

# ---- 淘宝联盟开放平台 ----
# 申请地址: https://open.taobao.com
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
# TAOBAO_OAUTH_REDIRECT_URI=https://shushang.online/api/v1/taobao/oauth/callback
