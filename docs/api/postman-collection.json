		{
			"name": "AI对话API",
			"item": [
				{
					"name": "1. 发送消息（非流式）",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.code === 200 && jsonData.data) {",
									"        pm.environment.set(\"conversation_id\", jsonData.data.conversation_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"请介绍一下内蒙古的特色农产品\",\n  \"conversation_id\": null,\n  \"agent_type\": \"assistant\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/chat/message",
							"host": ["{{base_url}}"],
							"path": ["chat", "message"]
						},
						"description": "发送对话消息（非流式响应）"
					},
					"response": []
				},
				{
					"name": "2. 发送消息（流式SSE）",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"请介绍一下内蒙古的特色农产品\",\n  \"conversation_id\": {{conversation_id}},\n  \"agent_type\": \"assistant\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/chat/stream",
							"host": ["{{base_url}}"],
							"path": ["chat", "stream"]
						},
						"description": "发送对话消息（流式SSE响应）"
					},
					"response": []
				},
				{
