								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message_id\": 1,\n  \"rating\": 5,\n  \"feedback\": \"回答很详细，很有帮助\",\n  \"feedback_type\": \"helpful\"\n}"
