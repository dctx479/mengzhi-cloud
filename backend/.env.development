# 开发环境配置
# 用于本地开发和调试

# 应用配置
DEBUG=True
APP_NAME=内蒙古农畜产品AI平台
VERSION=0.1.0
APP_ENV=development

# 日志
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# 数据库配置
# 开发环境使用本地MySQL
DATABASE_URL=mysql+pymysql://root:root123@localhost:3306/agri_platform?charset=utf8mb4
SQLALCHEMY_ECHO=True
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_RECYCLE=3600

# Redis配置
# 开发环境使用本地Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=5
REDIS_TIMEOUT=5

# JWT安全密钥
# 开发环境可使用简单密钥
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepSeek API配置
# 开发环境可以使用测试密钥或占位符
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_STREAM_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9

# CORS配置
# 开发环境允许所有本地请求
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# 邮件配置（可选）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@example.com

# 第三方服务配置
OSS_BUCKET=dev-bucket
OSS_REGION=oss-cn-beijing

# 缓存配置
CACHE_TTL=300  # 5分钟

# 功能开关
ENABLE_EMAIL_VERIFICATION=True
ENABLE_PHONE_VERIFICATION=True
ENABLE_TWO_FACTOR=False

# 数据库初始化
AUTO_CREATE_DB=True
LOAD_SAMPLE_DATA=True
