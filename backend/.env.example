# 应用配置
DEBUG=True
APP_NAME=内蒙古农畜产品AI平台
VERSION=0.1.0
ENVIRONMENT=development

# 数据库配置
# ⚠️ 安全提示: 生产环境请使用强密码，并确保.env文件不被提交到版本控制
# 建议: 使用环境变量或密钥管理服务（如AWS Secrets Manager）
DATABASE_URL=mysql+pymysql://root:CHANGE_THIS_PASSWORD@localhost:3306/agri_platform?charset=utf8mb4

# 或者分开配置（推荐用于生产环境）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=agri_platform

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT安全密钥(生产环境必须更换为至少32位的随机字符串)
# 生成强密钥命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 警告: 请勿在生产环境使用此默认值！
SECRET_KEY=PLEASE-GENERATE-A-STRONG-SECRET-KEY-USING-THE-COMMAND-ABOVE-DO-NOT-USE-THIS-DEFAULT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepSeek API配置
# 获取API密钥: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 超时配置(秒)
DEEPSEEK_TIMEOUT=120
DEEPSEEK_STREAM_TIMEOUT=300
DEEPSEEK_MAX_RETRIES=3
# 模型参数配置
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9

# CORS配置(多个域名用逗号分隔，生产环境使用)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 支付配置
PAYMENT_ENABLED=True
PAYMENT_DEV_MODE=True

# 支付宝配置（沙箱环境）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 微信支付配置（沙箱环境）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=
WECHAT_KEY_PATH=
