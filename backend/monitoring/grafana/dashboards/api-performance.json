{
  "id": null,
  "uid": "api-performance",
  "title": "API性能监控",
  "tags": [
    "api",
    "performance",
    "backend"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "QPS - 每秒请求数",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\"}[1m])) by (method, endpoint)",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "请求/秒",
          "logBase": 1,
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "pointradius": 2,
      "points": false,
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "max": true
      }
    },
    {
      "id": 2,
      "title": "总QPS",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\"}[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "当前并发请求数",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "http_requests_in_progress{job=\"backend\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "min": 0,
          "max": 200
        }
      }
    },
    {
      "id": 4,
      "title": "响应时间 P50/P95/P99",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le, endpoint))",
          "legendFormat": "P50 - {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le, endpoint))",
          "legendFormat": "P95 - {{endpoint}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le, endpoint))",
          "legendFormat": "P99 - {{endpoint}}",
          "refId": "C"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "响应时间",
          "logBase": 1,
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 0,
      "linewidth": 2,
      "thresholds": [
        {
          "value": 1,
          "colorMode": "warning",
          "op": "gt",
          "fill": false,
          "line": true
        },
        {
          "value": 3,
          "colorMode": "critical",
          "op": "gt",
          "fill": false,
          "line": true
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "max": true
      }
    },
    {
      "id": 5,
      "title": "平均响应时间",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"backend\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"backend\"}[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "P99响应时间",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "错误率 (%)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\",status=~\"5..\"}[5m])) by (endpoint) / sum(rate(http_requests_total{job=\"backend\"}[5m])) by (endpoint) * 100",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "错误率 (%)",
          "logBase": 1,
          "show": true,
          "min": 0
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 2,
      "linewidth": 2,
      "thresholds": [
        {
          "value": 1,
          "colorMode": "warning",
          "op": "gt",
          "fill": true,
          "line": true
        },
        {
          "value": 5,
          "colorMode": "critical",
          "op": "gt",
          "fill": true,
          "line": true
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "max": true
      },
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                5
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "1m",
        "handler": 1,
        "name": "API错误率高于5%",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 8,
      "title": "HTTP状态码分布",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\"}[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "请求/秒",
          "logBase": 1,
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "stack": true,
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "id": 9,
      "title": "Top 10 最慢的端点 (P95)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le, endpoint, method)))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "le": true
            },
            "indexByName": {},
            "renameByName": {
              "endpoint": "端点",
              "method": "方法",
              "Value": "P95响应时间(秒)"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "请求方法分布",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"backend\"}[5m])) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "show": true,
          "placement": "right"
        }
      }
    },
    {
      "id": 11,
      "title": "Top 10 最热门端点",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_requests_total{job=\"backend\"}[5m])) by (endpoint, method))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "endpoint": "端点",
              "method": "方法",
              "Value": "QPS"
            }
          }
        }
      ]
    },
    {
      "id": 12,
