# 生产环境配置
# 严格的生产环境设置

# 应用配置
DEBUG=False
APP_NAME=内蒙古农畜产品AI平台
VERSION=1.0.0
APP_ENV=production

# 日志
LOG_LEVEL=INFO
LOG_FILE=/var/log/agri-platform/app.log
LOG_ROTATION=10MB
LOG_RETENTION=30days

# 数据库配置
# 生产环境使用远程RDS或专用数据库服务器
DATABASE_URL=mysql+pymysql://prod_user:STRONG_PASSWORD_HERE@db.shushang.online:3306/agri_platform_prod?charset=utf8mb4
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=1800
SQLALCHEMY_POOL_PRE_PING=True

# Redis配置
# 生产环境使用专业的Redis服务
REDIS_URL=redis://redis-prod.example.com:6379/0
REDIS_PASSWORD=STRONG_PASSWORD_HERE
REDIS_POOL_SIZE=20
REDIS_TIMEOUT=10
REDIS_RETRY_ON_TIMEOUT=True

# JWT安全密钥
# 生产环境必须使用强加密密钥（至少32个随机字符）
SECRET_KEY=GENERATE_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepSeek API配置
# 生产环境必须使用真实的API密钥
DEEPSEEK_API_KEY=sk-xxx-production-key-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_STREAM_TIMEOUT=300
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9

# CORS配置
# 生产环境限制具体的前端域名
CORS_ORIGINS=https://shushang.online,https://www.shushang.online,https://api.shushang.online

# 京东联盟开放平台
JD_APP_KEY=
JD_SECRET_KEY=
JD_OAUTH_REDIRECT_URI=https://shushang.online/api/v1/jd/oauth/callback

# 淘宝联盟开放平台
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_ADZONE_ID=
TAOBAO_OAUTH_REDIRECT_URI=https://shushang.online/api/v1/taobao/oauth/callback

# 文件上传配置
MAX_UPLOAD_SIZE=52428800  # 50MB
UPLOAD_DIR=/data/uploads

# 邮件配置
SMTP_SERVER=smtp.sendcloud.net
SMTP_PORT=25
SMTP_USER=sendcloud_account
SMTP_PASSWORD=sendcloud_password
SMTP_FROM=noreply@shushang.online

# 第三方服务配置
OSS_BUCKET=prod-bucket
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-oss-key
OSS_ACCESS_KEY_SECRET=your-oss-secret

# CDN配置
CDN_DOMAIN=https://cdn.example.com

# 缓存配置
CACHE_TTL=600  # 10分钟

# 功能开关
ENABLE_EMAIL_VERIFICATION=True
ENABLE_PHONE_VERIFICATION=True
ENABLE_TWO_FACTOR=True

# 数据库初始化
AUTO_CREATE_DB=False
LOAD_SAMPLE_DATA=False

# 性能和安全
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
KEEP_ALIVE=5

# SSL配置
SSL_VERIFY=True
SSL_CERT_PATH=/etc/ssl/certs/shushang.online.crt
SSL_KEY_PATH=/etc/ssl/private/shushang.online.key

# 监控告警
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
MONITORING_ENABLED=True
METRICS_ENABLED=True

# 备份配置
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # 每天2点执行备份
BACKUP_RETENTION_DAYS=30
