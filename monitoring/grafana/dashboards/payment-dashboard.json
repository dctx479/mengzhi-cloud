{
  "dashboard": {
    "title": "支付系统监控仪表板",
    "tags": ["payment", "monitoring", "business"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "支付成功率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "(sum(rate(payment_success_total[5m])) by (payment_method) / sum(rate(payment_requests_total[5m])) by (payment_method)) * 100",
            "legendFormat": "{{payment_method}} 成功率",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "成功率", "min": 0, "max": 100}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [95], "type": "lt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "支付成功率低于95%",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 2,
        "title": "支付请求量 (QPS)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(payment_requests_total[1m])) by (payment_method)",
            "legendFormat": "{{payment_method}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "请求/秒"}
        ]
      },
      {
        "id": 3,
        "title": "支付失败率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(sum(rate(payment_failure_total[5m])) by (payment_method) / sum(rate(payment_requests_total[5m])) by (payment_method)) * 100",
            "legendFormat": "{{payment_method}} 失败率",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "失败率", "min": 0}
        ],
        "thresholds": [
          {"value": 5, "colorMode": "critical", "op": "gt", "fill": true, "line": true}
        ]
      },
      {
        "id": 4,
        "title": "支付失败原因分布",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(payment_failure_total[5m])) by (failure_reason)",
            "legendFormat": "{{failure_reason}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "支付响应时间 (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(payment_duration_seconds_bucket{operation=\"create_payment\"}[5m])) by (payment_method, le))",
            "legendFormat": "{{payment_method}} P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(payment_duration_seconds_bucket{operation=\"create_payment\"}[5m])) by (payment_method, le))",
            "legendFormat": "{{payment_method}} P99",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "响应时间"}
        ],
        "thresholds": [
          {"value": 5, "colorMode": "warning", "op": "gt", "fill": false, "line": true},
          {"value": 10, "colorMode": "critical", "op": "gt", "fill": false, "line": true}
        ]
      },
      {
        "id": 6,
        "title": "支付金额分布",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(payment_amount_histogram_bucket[5m])) by (le, payment_method)",
            "legendFormat": "{{payment_method}}",
            "refId": "A",
            "format": "heatmap"
          }
        ],
        "dataFormat": "tsbuckets"
      },
      {
        "id": 7,
        "title": "签名验证失败次数",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(payment_signature_verification_failures[1m])) by (payment_method)",
            "legendFormat": "{{payment_method}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "失败次数/分钟"}
        ],
        "thresholds": [
          {"value": 10, "colorMode": "critical", "op": "gt", "fill": true, "line": true}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [10], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "1m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "签名验证失败过多",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 8,
        "title": "金额验证失败次数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum(increase(payment_amount_mismatch_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]
        }
      },
      {
        "id": 9,
        "title": "并发支付请求数",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 24},
        "targets": [
          {
            "expr": "concurrent_payment_requests",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 50},
            {"color": "orange", "value": 100},
            {"color": "red", "value": 200}
          ]
        }
      },
      {
        "id": 10,
        "title": "待支付订单数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "payment_pending_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 500},
            {"color": "red", "value": 1000}
          ]
        }
      },
      {
        "id": 11,
        "title": "处理中支付数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 28},
        "targets": [
          {
            "expr": "payment_processing_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 12,
        "title": "配额发放成功率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "(sum(rate(quota_grant_total{status=\"success\"}[5m])) by (quota_type) / sum(rate(quota_grant_total[5m])) by (quota_type)) * 100",
            "legendFormat": "{{quota_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "成功率", "min": 0, "max": 100}
        ]
      },
      {
        "id": 13,
        "title": "配额发放响应时间",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(quota_grant_duration_seconds_bucket[5m])) by (quota_type, le))",
            "legendFormat": "{{quota_type}} P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "响应时间"}
        ]
      },
      {
        "id": 14,
        "title": "支付回调成功率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "(sum(rate(payment_callback_total{status=\"success\"}[5m])) by (payment_method) / sum(rate(payment_callback_total[5m])) by (payment_method)) * 100",
            "legendFormat": "{{payment_method}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "成功率", "min": 0, "max": 100}
        ]
      },
      {
        "id": 15,
        "title": "支付回调响应时间",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(payment_callback_duration_seconds_bucket[5m])) by (payment_method, le))",
            "legendFormat": "{{payment_method}} P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "响应时间"}
        ],
        "thresholds": [
          {"value": 3, "colorMode": "warning", "op": "gt", "fill": false, "line": true}
        ]
      },
      {
        "id": 16,
        "title": "总支付金额 (小时)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 48},
        "targets": [
          {
            "expr": "sum(increase(payment_amount_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyCNY"
          }
        }
      },
      {
        "id": 17,
        "title": "成功支付数 (小时)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 48},
        "targets": [
          {
            "expr": "sum(increase(payment_success_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 18,
        "title": "失败支付数 (小时)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 48},
        "targets": [
          {
            "expr": "sum(increase(payment_failure_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 10},
            {"color": "red", "value": 50}
          ]
        }
      }
    ]
  },
  "overwrite": true
}
