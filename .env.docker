# ============================
# Docker 部署环境变量配置
# ============================
# 使用方法: 复制此文件为 .env 并修改其中的值
#   cp .env.docker .env
#   然后编辑 .env 中的密钥和密码

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=agri_platform
MYSQL_USER=agri_user
MYSQL_PASSWORD=agri_pass

# ---- 后端应用 ----
# 环境标识 (development / production)
ENVIRONMENT=development
# JWT 密钥 (生产环境请生成随机强密钥: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-secret-key-please-change-in-production-env-32chars
# 数据加密密钥
ENCRYPTION_KEY=default-key-change-in-production

# ---- DeepSeek AI API ----
# 获取密钥: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- 京东联盟开放平台 ----
# 申请地址: https://union.jd.com
JD_APP_KEY=4830590ee7bd176788015888829dc8a4
JD_SECRET_KEY=77ebdc06c6a24983920fde2732993a55

# ---- 端口映射 ----
# 前端访问端口 (浏览器访问 http://localhost:FRONTEND_PORT)
FRONTEND_PORT=80
# 后端 API 端口 (可选, 直接访问后端 API 时使用)
BACKEND_PORT=8001
# MySQL 外部端口 (可选, 用数据库工具连接时使用)
MYSQL_PORT=3307
# Redis 外部端口 (可选)
REDIS_HOST_PORT=6380
