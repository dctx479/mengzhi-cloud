# 环境变量示例文件
# 复制此文件为 .env.development (开发) 或 .env.production (生产)

# API基础URL
# 开发环境：使用代理，设置为 /api (会自动代理到 http://localhost:8000)
# 生产环境：设置为实际后端地址，如 https://api.example.com
VITE_API_BASE_URL=/api

# 应用配置
VITE_APP_TITLE=内蒙古农畜产品AI平台
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于AI技术的农畜产品品牌营销智能化平台

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=true

# 重要说明:
# 1. 所有以 VITE_ 开头的变量都会暴露给客户端代码
# 2. 修改环境变量后需要重启开发服务器 (npm run dev)
# 3. VITE_API_BASE_URL 必须与 vite.config.ts 中的代理配置匹配
# 4. 开发环境下验证码为可选，生产环境需要配置验证码服务

